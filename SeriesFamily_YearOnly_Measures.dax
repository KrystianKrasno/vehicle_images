-- Series Family supplemental measures for annual-grain sales only.
-- Assumes the model already contains all measures from SalesRecords_YearOnly_Measures.dax.
--
-- Important:
-- 1) This is a DAX Studio query using DEFINE MEASURE for validation/reference.
-- 2) These definitions do NOT persist to the model from DAX Studio.
-- 3) To save them permanently, create/update them in Power BI or Tabular Editor.
--
-- Why this file is small:
-- Most core, record-chase, and status measures are context-aware and already
-- evaluate correctly at Series Family grain. Only family-specific ranking and
-- narrative measures that reference SELECTEDVALUE('d_VehicleSpecs'[Series Family])
-- or ALLSELECTED('d_VehicleSpecs'[Series Family]) live here.
--
-- Measures from SalesRecords_YearOnly_Measures.dax that work at family grain
-- without modification:
--   [Lifetime Sales], [Last Sales Year], [Last Year Sales], [Prior Year Sales],
--   [YoY Change vs Prior Year], [YoY % vs Prior Year], [First Sale Year],
--   [Best Sales Year], [Best Sales Value], [Prior Full-Year Record Year],
--   [Prior Full-Year Record Sales], [Gap to Full-Year Record],
--   [Sales Needed to Break Full-Year Record], [Pct to Full-Year Record],
--   [Overall Record Status]

DEFINE

    // -------------------------------------------------------------------------
    // Family ranking measures
    // -------------------------------------------------------------------------

    MEASURE 'Sales 1965-Date - Load'[Series Family Rank by Lifetime Sales] =
        VAR _currentSales = [Lifetime Sales]
        RETURN
            IF (
                ISINSCOPE ( 'd_VehicleSpecs'[Series Family] ),
                RANKX (
                    ALLSELECTED ( 'd_VehicleSpecs'[Series Family] ),
                    CALCULATE ( [Lifetime Sales] ),
                    _currentSales,
                    DESC,
                    DENSE
                )
            )

    MEASURE 'Sales 1965-Date - Load'[Top Series Family Name] =
        VAR _familyTable =
            FILTER (
                ADDCOLUMNS (
                    ALL ( 'd_VehicleSpecs'[Series Family] ),
                    "__Sales", CALCULATE ( [1965_Sales], REMOVEFILTERS ( 'd_Dates' ) )
                ),
                NOT ISBLANK ( [__Sales] )
                    && NOT ISBLANK ( 'd_VehicleSpecs'[Series Family] )
            )
        RETURN
            MAXX (
                TOPN (
                    1,
                    _familyTable,
                    [__Sales], DESC,
                    'd_VehicleSpecs'[Series Family], ASC
                ),
                'd_VehicleSpecs'[Series Family]
            )

    MEASURE 'Sales 1965-Date - Load'[Top Series Family Sales] =
        VAR _familyTable =
            FILTER (
                ADDCOLUMNS (
                    ALL ( 'd_VehicleSpecs'[Series Family] ),
                    "__Sales", CALCULATE ( [1965_Sales], REMOVEFILTERS ( 'd_Dates' ) )
                ),
                NOT ISBLANK ( [__Sales] )
                    && NOT ISBLANK ( 'd_VehicleSpecs'[Series Family] )
            )
        RETURN
            MAXX (
                TOPN (
                    1,
                    _familyTable,
                    [__Sales], DESC,
                    'd_VehicleSpecs'[Series Family], ASC
                ),
                [__Sales]
            )


    // -------------------------------------------------------------------------
    // Family narrative measures
    // These use SELECTEDVALUE to name the family in generated text.
    // -------------------------------------------------------------------------

    MEASURE 'Sales 1965-Date - Load'[Narrative - Top Series Family] =
        VAR _family = [Top Series Family Name]
        VAR _sales = [Top Series Family Sales]
        RETURN
            IF (
                NOT ISBLANK ( _family ),
                _family
                    & " is the top series family all-time with "
                    & FORMAT ( _sales, "#,0" )
                    & " sales."
            )

    MEASURE 'Sales 1965-Date - Load'[Narrative - Series Family Best Year] =
        VAR _family = SELECTEDVALUE ( 'd_VehicleSpecs'[Series Family] )
        VAR _yr = [Best Sales Year]
        VAR _sales = [Best Sales Value]
        RETURN
            IF (
                NOT ISBLANK ( _yr ),
                IF (
                    NOT ISBLANK ( _family ),
                    _family & " reached its best year in ",
                    "Best family sales year was "
                )
                    & FORMAT ( _yr, "0" )
                    & " with "
                    & FORMAT ( _sales, "#,0" )
                    & " sales."
            )

    MEASURE 'Sales 1965-Date - Load'[Narrative - Series Family Upcoming Record] =
        VAR _family = SELECTEDVALUE ( 'd_VehicleSpecs'[Series Family] )
        VAR _status = [Overall Record Status]
        VAR _need = [Sales Needed to Break Full-Year Record]
        VAR _recordYear = [Prior Full-Year Record Year]
        RETURN
            SWITCH (
                TRUE (),
                ISBLANK ( [Last Year Sales] ), BLANK (),
                _status = "No Prior Record",
                    IF (
                        NOT ISBLANK ( _family ),
                        _family & " has no prior annual record for comparison.",
                        "No prior family annual record exists for comparison."
                    ),
                _status = "Record Broken",
                    IF (
                        NOT ISBLANK ( _family ),
                        _family & " has already broken its prior annual record.",
                        "The selected family has already broken its prior annual record."
                    ),
                _status = "Tied Record",
                    IF (
                        NOT ISBLANK ( _family ),
                        _family & " is tied with its prior annual record.",
                        "The selected family is tied with its prior annual record."
                    ),
                TRUE (),
                    IF (
                        NOT ISBLANK ( _family ),
                        _family,
                        "The selected family"
                    )
                        & " is "
                        & FORMAT ( _need, "#,0" )
                        & " sales away from its prior annual record set in "
                        & FORMAT ( _recordYear, "0" )
                        & "."
            )


EVALUATE
ROW (
    "Top Series Family Name", [Top Series Family Name],
    "Top Series Family Sales", [Top Series Family Sales],
    "Narrative - Top Series Family", [Narrative - Top Series Family]
)
