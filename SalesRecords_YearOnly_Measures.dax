-- Unified Sales Records measure pack (annual-grain only).
--
-- Important:
-- 1) DAX Studio query using DEFINE MEASURE — for validation and reference.
-- 2) Query-scoped measures do NOT persist back to the Power BI model.
-- 3) To save permanently, create the measures in Power BI or Tabular Editor.
--
-- Model tables:
--   Fact:      'Sales 1965-Date - Load'
--   Calendar:  'd_Dates' with [Year], [Dates]
--   Dimension: 'Series' with [Series Code], [Series Family], [Series Sort Order],
--              [Luxury Type], [Active Flag], etc.
--
-- This file replaces the former SalesRecords + SeriesFamily + GapPatch files.
-- All measures are context-aware: they auto-adapt to Series Code, Series Family,
-- or overall grain depending on the visual's filter context.

DEFINE

    // =========================================================================
    // Base measure
    // =========================================================================

    MEASURE 'Sales 1965-Date - Load'[1965_Sales] =
        SUM ( 'Sales 1965-Date - Load'[Sales] )

    // =========================================================================
    // Internal helpers (not user-facing, consumed by live measures)
    // =========================================================================

    MEASURE 'Sales 1965-Date - Load'[Last Sales Year] =
        MAXX (
            FILTER (
                ALL ( 'd_Dates'[Year] ),
                CALCULATE ( [1965_Sales] ) > 0
            ),
            'd_Dates'[Year]
        )

    MEASURE 'Sales 1965-Date - Load'[Prior Year Sales] =
        VAR LatestYear = [Last Sales Year]
        RETURN
            IF (
                NOT ISBLANK ( LatestYear ),
                CALCULATE (
                    [1965_Sales],
                    FILTER ( ALL ( 'd_Dates' ), 'd_Dates'[Year] = LatestYear - 1 )
                )
            )

    MEASURE 'Sales 1965-Date - Load'[Prior Full-Year Record Sales] =
        VAR LatestYear = [Last Sales Year]
        VAR YearSalesTable =
            FILTER (
                ADDCOLUMNS (
                    SUMMARIZE (
                        FILTER ( ALL ( 'd_Dates' ), 'd_Dates'[Year] < LatestYear ),
                        'd_Dates'[Year]
                    ),
                    "AnnualSales", CALCULATE ( [1965_Sales] )
                ),
                NOT ISBLANK ( [AnnualSales] )
            )
        RETURN
            MAXX (
                TOPN ( 1, YearSalesTable, [AnnualSales], DESC, 'd_Dates'[Year], DESC ),
                [AnnualSales]
            )

    MEASURE 'Sales 1965-Date - Load'[Pct to Full-Year Record] =
        DIVIDE ( [Current Year Sales], [Prior Full-Year Record Sales] )


    // =========================================================================
    // Live measures (1-10)
    // =========================================================================

    // 1. Lifetime Sales
    MEASURE 'Sales 1965-Date - Load'[Lifetime Sales] =
        CALCULATE ( [1965_Sales], REMOVEFILTERS ( 'd_Dates' ) )

    // 2. First Sales Year
    MEASURE 'Sales 1965-Date - Load'[First Sales Year] =
        MINX (
            FILTER (
                ALL ( 'd_Dates'[Year] ),
                CALCULATE ( [1965_Sales] ) > 0
            ),
            'd_Dates'[Year]
        )

    // 3. Best Sales Year
    MEASURE 'Sales 1965-Date - Load'[Best Sales Year] =
        VAR YearSalesTable =
            FILTER (
                ADDCOLUMNS (
                    ALL ( 'd_Dates'[Year] ),
                    "AnnualSales", CALCULATE ( [1965_Sales] )
                ),
                NOT ISBLANK ( [AnnualSales] )
            )
        RETURN
            MAXX (
                TOPN ( 1, YearSalesTable, [AnnualSales], DESC, 'd_Dates'[Year], DESC ),
                'd_Dates'[Year]
            )

    // 4. Best Annual Sales
    MEASURE 'Sales 1965-Date - Load'[Best Annual Sales] =
        VAR YearSalesTable =
            FILTER (
                ADDCOLUMNS (
                    ALL ( 'd_Dates'[Year] ),
                    "AnnualSales", CALCULATE ( [1965_Sales] )
                ),
                NOT ISBLANK ( [AnnualSales] )
            )
        RETURN
            MAXX (
                TOPN ( 1, YearSalesTable, [AnnualSales], DESC, 'd_Dates'[Year], DESC ),
                [AnnualSales]
            )

    // 5. Current Year Sales
    MEASURE 'Sales 1965-Date - Load'[Current Year Sales] =
        VAR LatestYear = [Last Sales Year]
        RETURN
            IF (
                NOT ISBLANK ( LatestYear ),
                CALCULATE (
                    [1965_Sales],
                    FILTER ( ALL ( 'd_Dates' ), 'd_Dates'[Year] = LatestYear )
                )
            )

    // 6. Rank by Lifetime Sales (unified — auto-detects Series Code or Family grain)
    MEASURE 'Sales 1965-Date - Load'[Rank by Lifetime Sales] =
        SWITCH (
            TRUE (),
            ISINSCOPE ( 'Series'[Series Code] ),
                RANKX (
                    ALLSELECTED ( 'Series'[Series Code] ),
                    CALCULATE ( [1965_Sales], REMOVEFILTERS ( 'd_Dates' ) ),
                    ,
                    DESC,
                    DENSE
                ),
            ISINSCOPE ( 'Series'[Series Family] ),
                RANKX (
                    ALLSELECTED ( 'Series'[Series Family] ),
                    CALCULATE ( [1965_Sales], REMOVEFILTERS ( 'd_Dates' ) ),
                    ,
                    DESC,
                    DENSE
                )
        )

    // 7. YoY %
    MEASURE 'Sales 1965-Date - Load'[YoY %] =
        DIVIDE (
            [Current Year Sales] - [Prior Year Sales],
            [Prior Year Sales]
        )

    // 8. Overall Record Status
    MEASURE 'Sales 1965-Date - Load'[Overall Record Status] =
        VAR RecordGap = [Gap to Full-Year Record]
        VAR RecordPct = [Pct to Full-Year Record]
        RETURN
            SWITCH (
                TRUE (),
                ISBLANK ( [Current Year Sales] ), BLANK (),
                ISBLANK ( [Prior Full-Year Record Sales] ), "No Prior Record",
                RecordGap < 0, "Record Broken",
                RecordGap = 0, "Tied Record",
                RecordPct >= 0.95, "Near Record",
                "Below Record"
            )

    // 9. Prior Full-Year Record Year
    MEASURE 'Sales 1965-Date - Load'[Prior Full-Year Record Year] =
        VAR LatestYear = [Last Sales Year]
        VAR YearSalesTable =
            FILTER (
                ADDCOLUMNS (
                    SUMMARIZE (
                        FILTER ( ALL ( 'd_Dates' ), 'd_Dates'[Year] < LatestYear ),
                        'd_Dates'[Year]
                    ),
                    "AnnualSales", CALCULATE ( [1965_Sales] )
                ),
                NOT ISBLANK ( [AnnualSales] )
            )
        RETURN
            MAXX (
                TOPN ( 1, YearSalesTable, [AnnualSales], DESC, 'd_Dates'[Year], DESC ),
                'd_Dates'[Year]
            )

    // 10. Gap to Full-Year Record
    MEASURE 'Sales 1965-Date - Load'[Gap to Full-Year Record] =
        VAR PriorRecordSales = [Prior Full-Year Record Sales]
        RETURN
            IF (
                ISBLANK ( PriorRecordSales ),
                BLANK (),
                PriorRecordSales - [Current Year Sales]
            )


EVALUATE
ROW (
    "Lifetime Sales", [Lifetime Sales],
    "First Sales Year", [First Sales Year],
    "Best Sales Year", [Best Sales Year],
    "Best Annual Sales", [Best Annual Sales],
    "Current Year Sales", [Current Year Sales],
    "YoY %", [YoY %],
    "Prior Full-Year Record Year", [Prior Full-Year Record Year],
    "Gap to Full-Year Record", [Gap to Full-Year Record],
    "Overall Record Status", [Overall Record Status]
)
